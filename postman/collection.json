{
  "info": {
    "_postman_id": "c895f39d-5919-570d-a0e7-0e933f31d3fa",
    "name": "Local Tour Guide and Itinerary Coordination System",
    "description": "Run in order: 1) Authentication (Register -> Login saves the JWT automatically), 2) each resource folder, 3) Security & Validation tests, 4) Cleanup. IDs and the token are stored in collection variables, so nothing needs to be copied by hand. Set baseUrl if your port differs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "languageId",
      "value": ""
    },
    {
      "key": "guideProfileId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "guideLanguageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"fullName\": \"Demo User\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Creates the demo account. A 409 simply means it already exists — go on to Login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created (201) or already registered (409)', function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Password hash is never returned', function () { pm.expect(json).to.not.have.property('passwordHash'); });",
                  "  pm.collectionVariables.set('userId', json.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Returns the JWT. The token is stored in the {{token}} collection variable automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Response contains a JWT access_token', function () { pm.expect(json.access_token).to.be.a('string').and.not.empty; });",
                  "// Saved automatically — every other request uses {{token}} via the collection's Bearer auth.",
                  "pm.collectionVariables.set('token', json.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (JWT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Protected route. Uses the Bearer token saved by Login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Returns the logged-in user without a password', function () {",
                  "  pm.expect(json).to.have.property('email');",
                  "  pm.expect(json).to.not.have.property('passwordHash');",
                  "});",
                  "pm.collectionVariables.set('userId', json.id);"
                ]
              }
            }
          ]
        }
      ]
    },
